+  // WSL fork: bundle the daemon binaries for auto-deployment into WSL.
+  // Both arches ship in every installer — the right one is picked at runtime
+  // from the distro's `uname -m` (x64 keeps the unsuffixed name for
+  // back-compat). The arm64 binary is optional so local x64-only dev
+  // builds keep working.
+  for (const name of ['wsl-git-daemon', 'wsl-git-daemon-arm64']) {
+    const daemonSource = path.resolve(projectRoot, 'wsl-daemon', name)
+    const daemonDest = path.resolve(outRoot, name)
+    if (existsSync(daemonSource)) {
+      console.log(`  Copying ${name} binary`)
+      cpSync(daemonSource, daemonDest)
+    } else {
+      console.log(
+        `  Warning: ${name} not found (build with make in wsl-daemon/)`
+      )
+    }
+  }
 }
 
